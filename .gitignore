# ALLOWLIST: everything is private unless named below.
# Kept out on purpose: the voice clone (voice/, config/voice.json, takes), videos and renders, captured third-party
# pages, generated audio, downloaded reference reels, node_modules. A new file stays private until it is named here.
/*
!/.gitignore
!/README.md
!/PRINCIPLES.md
!/LESSONS.md
!/LICENSE
!/PIPELINE.md

!/config/
/config/*
!/config/voice.example.json

!/engine/
/engine/*
!/engine/package.json
!/engine/package-lock.json

!/skill/
!/tools/
/tools/render.py
/tools/gen_images.sh
/tools/gen_one.sh

!/research/
/research/*
!/research/style-guide.md
!/research/script-playbook.md
!/research/motion-playbook.md
!/research/topic-backlog.md
!/research/made.json

!/shorts/
/shorts/*
!/shorts/2026-11-api-key-leak/
!/shorts/2026-11-rag/
/shorts/2026-11-*/*
!/shorts/2026-11-*/script.md
!/shorts/2026-11-*/vo.txt
!/shorts/2026-11-*/dossier.md
!/shorts/2026-11-*/storyboard.md
!/shorts/2026-11-*/storyboard-captions.md
!/shorts/2026-11-*/evidence/
/shorts/2026-11-*/evidence/*
!/shorts/2026-11-*/evidence/shots.json
!/shorts/2026-11-*/comp/
/shorts/2026-11-*/comp/*
!/shorts/2026-11-*/comp/build.py
!/shorts/2026-11-*/comp/index.html.tmpl
!/shorts/2026-11-*/comp/hyperframes.json

__pycache__/
.DS_Store
*.bak*
