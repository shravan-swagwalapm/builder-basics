  <!-- stepper rail -->
  <svg id="rail" viewBox="0 0 1080 400" data-layout-ignore><defs><marker id="ah" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10z" fill="#3A4160"/></marker></defs><path class="flow" d="M228 214 H354" marker-end="url(#ah)"/><path class="flow" d="M474 214 H600" marker-end="url(#ah)"/><path class="flow" d="M720 214 H846" marker-end="url(#ah)"/></svg>
  <div class="step" id="s1"><svg viewBox="-52 -52 104 104"><path d="M-26 -16 h52 v30 h-52z M-34 18 h68" fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round" stroke-linecap="round"/></svg></div><div class="step" id="s2"><svg viewBox="-52 -52 104 104"><path d="M-22 -24 h36 l10 10 v38 h-46z M-10 -2 a6 6 0 1 0 0.1 0 M-10 4 v12 M-10 4 q0 -6 14 -6" fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round" stroke-linecap="round"/></svg></div><div class="step" id="s3"><svg viewBox="-52 -52 104 104"><path d="M-24 18 a34 34 0 0 1 48 -48 M-14 8 a20 20 0 0 1 28 -28 M-3 -3 l20 -20" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/><circle cx="-3" cy="-3" r="6" fill="currentColor"/></svg></div><div class="step" id="s4"><svg viewBox="-52 -52 104 104"><path d="M0 -26 a12 12 0 1 1 -0.1 0 M-24 26 q0 -26 24 -26 q24 0 24 26" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg></div>
  <svg id="shieldmini" viewBox="0 0 38 68"><path d="M19 3 L34 10 V34 C34 50 27 59 19 65 C11 59 4 50 4 34 V10 Z" fill="rgba(74,222,154,.15)" stroke="#4ADE9A" stroke-width="3"/></svg>
  <svg id="key" viewBox="0 0 64 30"><circle cx="15" cy="15" r="10" fill="none" stroke="#F5B94A" stroke-width="6"/><path d="M25 15 H60 M51 15 V26 M43 15 V23" stroke="#F5B94A" stroke-width="6" stroke-linecap="round"/></svg>

  <div class="ttl" id="t1"><span class="tw lt">Your</span> <span class="tw lt">key</span> <span class="tw lt">can</span> <span class="tw lt">go</span> <span class="tw acc">public.</span></div>
  <div class="ttl" id="t2"><span class="tw lt">This</span> <span class="tw lt">isn't</span> <span class="tw">rare.</span></div>
  <div class="ttl" id="t3"><span class="tw lt">Scanners</span> <span class="tw">never</span> <span class="tw acc">sleep.</span></div>
  <div class="ttl" id="t4"><span class="tw lt">Deleted</span> <span class="tw">≠</span> <span class="tw bad">gone.</span></div>
  <div class="ttl" id="t5"><span class="tw lt">Public</span> <span class="tw lt">for</span> <span class="tw bad">~5 years.</span></div>
  <div class="ttl" id="t6"><span class="tw lt">GitHub</span> <span class="tw lt">blocks</span> <span class="tw good">some keys.</span></div>
  <div class="ttl" id="t7"><span class="tw lt">Except</span> <span class="tw bad">Gemini.</span></div>
  <div class="ttl" id="t8"><span class="tw lt">One</span> <span class="tw good">rule.</span></div>
  <div class="ttl" id="t9"><span class="tw lt">Leaked?</span> <span class="tw acc">Rotate first.</span></div>
  <div class="ttl" id="t10"><span class="tw lt">Two</span> <span class="tw acc">minutes.</span></div>

  <!--__CAPTIONS__-->

  <div id="vignette"></div>
  <audio id="mix" class="clip" src="assets/mix.wav" data-start="0" data-duration="__END__" data-has-audio="true"></audio>
</div>

<script>
/*__T__*/
const tl = gsap.timeline({ paused: true });
const E = { in: "expo.out", cam: "power2.inOut", out: "power3.in" };

function show(id, t, hold, blur) {   // arrive slow (blur-in), leave clean
  tl.fromTo(id, { opacity: 0, filter: `blur(${blur || 6}px)`, y: 10 }, { opacity: 1, filter: "blur(0px)", y: 0, duration: 0.4, ease: E.in, immediateRender: false }, t);
  if (hold) tl.to(id, { opacity: 0, filter: "blur(8px)", duration: 0.2, ease: E.out }, t + hold);
}
const TITLE_STYLES = {   // HyperFrames motion.md: vary title entrances within a film
  blur: [{ opacity: 0, filter: "blur(6px)", y: 0 }, { duration: 0.13, ease: "power2.out", stagger: 0.067 }],   // per word, no translate
  line: [{ opacity: 0, filter: "blur(8px)", y: 0 }, { duration: 0.18, ease: "power2.out", stagger: 0 }],       // whole line blurs in
  rise: [{ opacity: 0, filter: "blur(0px)", y: 40 }, { duration: 0.5, ease: "expo.out", stagger: 0.08 }],      // per word rise
};
function title(id, t0, t1, style) {
  const w = id + " .tw", [from, how] = TITLE_STYLES[style];
  tl.fromTo(w, from, { opacity: 1, filter: "blur(0px)", y: 0, ...how, immediateRender: false }, t0);
  if (t1 < T.end) tl.to(w, { opacity: 0, filter: "blur(6px)", duration: 0.18, ease: E.out, stagger: 0.03 }, t1 - 0.24);
}
function step(on, t, color) {          // light the active icon node
  ["#s1", "#s2", "#s3", "#s4"].forEach(s => {
    const lit = on.includes(s), c = color || "#7C8CFF";
    tl.to(s, { color: lit ? c : "#7D86A8", borderColor: lit ? c : "#3A4160", boxShadow: lit ? `0 0 26px -4px ${c}` : "0 0 0 0 rgba(0,0,0,0)", scale: lit ? 1.06 : 1, duration: 0.35, ease: E.cam }, t);
  });
}
function cam(scale, x, y, t, d) { tl.to("#world", { scale, x, y, duration: d || 0.9, ease: E.cam }, t); }
const P = { s1: [168, 298], s2: [414, 298], s3: [660, 298], s4: [906, 298] };   // key rides just under its icon node
function keyTo(p, t, d, ease) { tl.to("#key", { x: P[p][0] - 32, y: P[p][1] - 15, duration: d || 0.7, ease: ease || E.cam }, t); }
function flood(color, op, t) { tl.to("#flood", { backgroundColor: color, opacity: op, duration: 0.4, ease: E.cam }, t); }

// ---------- continuous world motion (authored, seek-safe) ----------
tl.fromTo("#barfill", { scaleX: 0 }, { scaleX: 1, duration: T.end, ease: "none", immediateRender: true }, 0);   // episode progress
tl.fromTo("#g1", { x: -40, y: 0 }, { x: 80, y: -60, duration: T.end, ease: "sine.inOut", immediateRender: true }, 0);
tl.fromTo("#g2", { x: 40, y: 0 }, { x: -90, y: 50, duration: T.end, ease: "sine.inOut", immediateRender: true }, 0);
gsap.set("#plane", { transformPerspective: 1100, rotationX: 48, rotationZ: -14 });
tl.fromTo("#plane", { x: 0, rotationZ: -14 }, { x: -420, rotationZ: -2, duration: T.because - T.rare + 0.6, ease: "none", immediateRender: false }, T.rare);   // world turning (~1.2 deg/s)

tl.fromTo("#rg1", { rotation: 0 }, { rotation: 4 * T.end, duration: T.end, ease: "none", immediateRender: true }, 0);    // ~4 deg/s: a world turning, not a UI loop
tl.fromTo("#rg2", { rotation: 0 }, { rotation: -2.5 * T.end, duration: T.end, ease: "none", immediateRender: true }, 0);
tl.fromTo("#rg3", { rotation: 0 }, { rotation: 1.5 * T.end, duration: T.end, ease: "none", immediateRender: true }, 0);
function rings(color, t) { tl.to("#rings .rr", { stroke: color, duration: 0.5, ease: E.cam }, t); tl.to("#rings .rdot", { fill: color, duration: 0.5, ease: E.cam }, t); }   // stroke only: fill turned rings into solid discs

// ---------- frame 0 ----------
gsap.set("#key", { x: P.s1[0] - 32, y: P.s1[1] - 15 });
show("#term1", T.open, null, 8);                          // terminal builds in after the evidence flash
tl.fromTo("#bar,#rail,.step,#key", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: E.in, stagger: 0.04, immediateRender: false }, T.open - 0.05);
title("#t1", T.open + 0.1, T.rare, "rise");
step(["#s1"], 0);
tl.fromTo(".flow", { strokeDashoffset: 0 }, { strokeDashoffset: -18 * Math.round(T.end * 2), duration: T.end, ease: "none", immediateRender: true }, 0);   // data flows along the rail
tl.fromTo(".arw", { strokeDashoffset: 0 }, { strokeDashoffset: -19 * Math.round(T.end * 2), duration: T.end, ease: "none", immediateRender: true }, 0);   // arrows flow

// ---------- A1: the honeypot ----------
show("#orca", T.orca, T.two - T.orca - 0.2, 4);
tl.fromTo("#up", { scaleX: 0, opacity: 1 }, { scaleX: 1, opacity: 1, duration: 0.8, ease: "power1.inOut", immediateRender: false }, T.pushed + 0.6);   // upload runs
tl.to("#up", { opacity: 0, duration: 0.15 }, T.pushed + 1.45);
tl.fromTo("#tl3o", { opacity: 0 }, { opacity: 1, duration: 0.25, immediateRender: false }, T.pushed + 1.45);
keyTo("s2", T.pushed + 1.45, 0.8); step(["#s1", "#s2"], T.pushed + 1.45);
cam(1.03, 0, 20, T.pushed, 1.2);
tl.to("#term1", { opacity: 0, filter: "blur(8px)", duration: 0.2, ease: E.out }, T.two - 0.2);
show("#timer", T.two, T.ev_orca - T.two - 0.25, 10); show("#timer_l", T.two + 0.2, T.ev_orca - T.two - 0.45);   // the real report takes over
keyTo("s4", T.two + 0.4, 0.7, E.out); step(["#s4"], T.two + 0.4, "#FF5A6E");
flood("#FF5A6E", 0.07, T.two + 1.1); rings("#FF5A6E", T.two); cam(1, 0, 0, T.two, 0.8);

// ---------- A2: scale ----------
flood("#FF5A6E", 0, T.rare); step([], T.rare);
title("#t2", T.rare, T.because, "blur"); rings("#F5B94A", T.rare);
show("#planewrap", T.ev_orca_out + 0.05, T.ev_gg - T.ev_orca_out - 0.05, 12); show("#scrim", T.n2865 - 0.3, T.ev_gg - T.n2865 + 0.3);
show("#secrets", T.n2865 - 0.15, T.ev_gg - T.n2865 - 0.05); show("#secrets_l", T.n2865, T.ev_gg - T.n2865 - 0.2); show("#secrets_src", T.n2865 + 0.3, T.ev_gg - T.n2865 - 0.5);   // gone before the real page lands
cam(1, 0, -12, T.rare, 1.4);   // no pull-back: it shrank type under the 28px floor

// ---------- A3: scanners ----------
title("#t3", T.because, T.deleting, "line"); rings("#7C8CFF", T.because);
show("#matrixwrap", T.because + 0.1, T.deleting - T.because - 0.45, 10);
tl.fromTo("#beam", { x: -120, opacity: 1 }, { x: 782, opacity: 1, duration: 1.6, ease: "power1.inOut", immediateRender: false }, T.searchable);
tl.to("#beam", { opacity: 0, duration: 0.1 }, T.searchable + 1.6);
tl.fromTo("#beam", { x: -120, opacity: 1 }, { x: 782, opacity: 1, duration: 1.4, ease: "power1.inOut", immediateRender: false }, T.searchable + 1.7);
tl.to("#beam", { opacity: 0, duration: 0.12 }, T.searchable + 3.1);
tl.to("#hotdot", { attr: { r: 11 }, fill: "#FF5A6E", duration: 0.3, ease: E.in }, T.shaped);
show("#hottag", T.shaped + 0.15, T.deleting - T.shaped - 0.5, 4);
step(["#s2", "#s3"], T.searchable); keyTo("s3", T.scanners, 0.6); cam(1.04, 0, -20, T.because, 1.0);

// ---------- A4: deleted is not gone ----------
title("#t4", T.deleting, T.toyota, "blur"); cam(1, 0, 0, T.deleting, 0.8);
show("#term2", T.deleting - 0.1, T.toyota - T.deleting - 0.1);
tl.fromTo("#tl4o", { opacity: 0 }, { opacity: 1, duration: 0.25, immediateRender: false }, T.deleting + 1.85);   // after the commit line finishes typing
[["#kc1", T.history, 286], ["#kc2", T.forks, 611], ["#kc3", T.caches, 936]].forEach(([k, t, x]) => {   // the example travels into each copy
  tl.fromTo(k, { x: 560, y: 690, opacity: 1, scale: 1.2 }, { x, y: 1056, opacity: 1, scale: 1, duration: 0.55, ease: E.in, immediateRender: false }, t - 0.2);   // lands bottom-right of the card, clear of its text
  tl.to(k, { opacity: 0, duration: 0.2 }, T.toyota - 0.05);
});
show("#ab1", T.history - 0.3, T.toyota - T.history - 0.1, 2); show("#ab2", T.forks - 0.3, T.toyota - T.forks - 0.1, 2); show("#ab3", T.caches - 0.5, T.toyota - T.caches - 0.1, 2);
show("#cp1", T.history - 0.25, T.toyota - T.history + 0.2); show("#cp2", T.forks - 0.25, T.toyota - T.forks + 0.2); show("#cp3", T.caches - 0.45, T.toyota - T.caches + 0.4);

// ---------- A5: Toyota ----------
title("#t5", T.toyota, T.pp, "rise"); cam(1.04, 0, -20, T.toyota, 1.4);
const TC = T.ev_toy_out;   // the timeline starts when the real disclosure page leaves
show("#toyota_l", TC, T.pp - TC - 0.25); show("#chart", TC + 0.1, T.pp - TC - 0.35);
tl.fromTo("#tline", { strokeDasharray: 1100, strokeDashoffset: 1100 }, { strokeDashoffset: 0, duration: T.five - TC - 0.1, ease: "power1.inOut", immediateRender: true }, TC + 0.15);
tl.fromTo("#tcr", { attr: { width: 40 } }, { attr: { width: 900 }, duration: T.five - TC - 0.1, ease: "power1.inOut", immediateRender: false }, TC + 0.15);
tl.to("#tdot", { opacity: 1, duration: 0.2 }, T.five);
show("#year", TC + 0.2, T.pp - TC - 0.45);
show("#emails", T.five - 0.3, T.pp - 0.25 - (T.five - 0.3));   // final value readable ~1 s, gone before the next scene

// ---------- A6: push protection ----------
title("#t6", T.pp, T.gemini, "line"); rings("#4ADE9A", T.pp); cam(1, 0, 0, T.pp, 0.9);
show("#called", T.pp_word, T.gemini - T.pp_word - 0.2, 10);
show("#lapP", T.pp + 0.3, T.rule - T.pp - 0.5); show("#ap1", T.pp_word + 0.2, T.rule - T.pp_word - 0.5, 2); show("#ap2", T.pp_word + 0.3, T.rule - T.pp_word - 0.6, 2); show("#ghP", T.pp + 0.4, T.rule - T.pp - 0.6);
tl.fromTo("#shieldbig", { opacity: 0, y: -60, scale: 0.7 }, { opacity: 1, y: 0, scale: 1, duration: 0.5, ease: "back.out(1.3)", immediateRender: false }, T.pp_word);
tl.to("#shieldbig", { opacity: 0, duration: 0.2, ease: E.out }, T.rule - 0.2);
tl.fromTo("#shieldmini", { opacity: 0, y: -30 }, { opacity: 1, y: 0, duration: 0.4, ease: "back.out(1.3)", immediateRender: false }, T.pp_word);
keyTo("s1", T.pp, 0.6); step(["#s1", "#s2"], T.pp, "#4ADE9A");
flood("#4ADE9A", 0.06, T.pp_word);
show("#k_openai", T.openai - 0.1); tl.to("#k_openai", { x: 200, duration: 0.35, ease: "power2.in" }, T.openai + 0.3);
tl.to("#k_openai", { x: 0, duration: 0.55, ease: "back.out(1.2)" }, T.openai + 0.65);
show("#k_anth", T.anthropic - 0.1); tl.to("#k_anth", { x: 180, duration: 0.35, ease: "power2.in" }, T.anthropic + 0.3);
tl.to("#k_anth", { x: 0, duration: 0.55, ease: "back.out(1.2)" }, T.anthropic + 0.65);
[["#rp1", T.openai + 0.6], ["#rp2", T.anthropic + 0.6]].forEach(([r, t]) =>   // impact: caused by the bounce
  tl.fromTo(r, { attr: { r: 60 }, opacity: 0.9 }, { attr: { r: 280 }, opacity: 0, duration: 0.7, ease: "power2.out", immediateRender: false }, t));
show("#off", T.switch, T.gemini - T.switch - 0.2);
tl.to("#k_openai,#k_anth", { opacity: 0, filter: "blur(6px)", duration: 0.2 }, T.gemini - 0.2);

// ---------- A7: the exception ----------
title("#t7", T.gemini, T.rule, "blur"); rings("#FF5A6E", T.gemini);
flood("#FF5A6E", 0.07, T.gemini + 0.3); cam(1.04, 40, 0, T.gemini, 0.9);
show("#k_gem", T.gemini);
tl.to("#k_gem", { x: 640, duration: 1.0, ease: "power2.inOut" }, T.gemini + 0.5);
tl.to("#ghP", { borderColor: "#FF5A6E", boxShadow: "0 0 30px -6px #FF5A6E", duration: 0.3 }, T.gemini + 1.4);
show("#gem_l", T.gemini + 0.35, T.rule - T.gemini - 0.4);
tl.to("#k_gem", { opacity: 0, filter: "blur(6px)", duration: 0.2 }, T.rule - 0.2);

// ---------- A8: the rule ----------
flood("#FF5A6E", 0, T.rule);
title("#t8", T.rule, T.leaks, "blur"); rings("#4ADE9A", T.rule); cam(1, 0, 0, T.rule, 0.8); step(["#s1"], T.rule, "#4ADE9A");
show("#term3", T.rule + 0.1, T.leaks - T.rule - 0.3);
tl.fromTo("#sweep", { x: -240 }, { x: 900, duration: 0.7, ease: "power2.inOut", immediateRender: false }, T.gitignore + 0.3);   // the command runs
tl.fromTo("#tr2o", { opacity: 0 }, { opacity: 1, duration: 0.25, immediateRender: false }, T.first + 0.15);

// ---------- A9: leaked? ----------
title("#t9", T.leaks, T.cb, "rise"); cam(1.03, 0, -10, T.leaks, 1.0);
show("#st1", T.rotate - 0.1, T.cb - T.rotate); show("#as1", T.rotate + 0.3, T.cb - T.rotate - 0.5, 2);
tl.fromTo("#rk", { rotation: 0 }, { rotation: 360, duration: 0.9, ease: "power2.inOut", transformOrigin: "50% 50%", immediateRender: false }, T.rotate + 0.1);
show("#st2", T.clean - 0.1, T.cb - T.clean - 0.1);

// ---------- A10: callback ----------
title("#t10", T.cb, T.end + 1, "line"); rings("#7C8CFF", T.cb); cam(1, 0, 0, T.cb, 1.2);
tl.set("#timer", { textContent: "2:00" }, T.cb);
show("#timer", T.cb + 0.2, null, 10); show("#timer_l", T.cb + 0.4);
tl.to("#shieldmini", { opacity: 0, duration: 0.25, ease: E.out }, T.cb);   // the test had no shield
keyTo("s4", T.head, 1.0); step(["#s4"], T.head, "#FF5A6E");

// counters, typing, captions (authored frame rows)
/*__COUNTERS_JS__*/
/*__TYPED_JS__*/
/*__EVIDENCE_JS__*/
/*__SLOT_JS__*/
/*__CAPTIONS_JS__*/

window.__timelines = window.__timelines || {};
window.__timelines["main"] = tl;
tl.seek(0);
</script>
</body>
</html>
