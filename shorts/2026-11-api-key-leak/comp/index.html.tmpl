<!doctype html>
<html lang="en" data-resolution="portrait">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=1080, height=1920" />
<script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&family=JetBrains+Mono:wght@400;500;700&display=block" rel="stylesheet" />
<style>
  /* Builder Basics look v2 = Rethink film (indigo ground, gradient numerals, dot matrix, light/heavy type)
     + Algo Reels (header bar, section tag, stepper, neon hairline panels, "THIS IS CALLED" callouts) */
  :root {
    --bg: #07090F; --ink: #F4F6FF; --mute: #7D86A8; --faint: #3A4160;
    --accent: #7C8CFF; --good: #4ADE9A; --warn: #F5B94A; --bad: #FF5A6E;
    --display: "Plus Jakarta Sans", "Helvetica Neue", sans-serif; --mono: "JetBrains Mono", Menlo, monospace;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 1080px; height: 1920px; overflow: hidden; background: var(--bg); }
  #root { position: relative; width: 1080px; height: 1920px; overflow: hidden; font-family: var(--display); color: var(--ink); }

  /* ground: soft indigo glows (Rethink); the world behind moves slowly */
  #bg { position: absolute; inset: 0; overflow: hidden; }
  #world { position: absolute; inset: 0; transform-origin: 540px 940px; }
  #ground { position: absolute; inset: 0; background: var(--bg); }
  .glow { position: absolute; border-radius: 50%; }   /* soft by gradient alone: CSS blur clipped square under zoom + motion blur */
  #g1 { left: -220px; top: 320px; width: 960px; height: 960px; background: radial-gradient(circle, rgba(43,63,158,.5), rgba(43,63,158,.18) 40%, transparent 70%); }
  #g2 { left: 420px; top: 800px; width: 900px; height: 900px; background: radial-gradient(circle, rgba(30,44,100,.6), rgba(30,44,100,.2) 40%, transparent 70%); }
  #flood { position: absolute; left: -300px; top: -300px; width: 1680px; height: 2520px; background: var(--bad); opacity: 0; }
  #vignette { position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 45%, transparent 50%, rgba(0,0,0,.6)); pointer-events: none; }

  /* top: progress line only (Shravan 2026-11-05: no header/series text, no section tags) */
  #bar { position: absolute; left: 70px; width: 940px; top: 120px; height: 3px; border-radius: 2px; background: var(--faint); }
  #barfill { position: absolute; left: 0; top: 0; height: 2px; width: 940px; background: var(--accent); transform-origin: 0 50%; transform: scaleX(0); box-shadow: 0 0 10px var(--accent); }

  /* stepper rail (Algo Reels); the key travels it */
  /* stepper = icon nodes joined by flowing arrows (no text) */
  .step { position: absolute; top: 162px; width: 104px; height: 104px; border-radius: 50%; border: 2px solid var(--faint); background: rgba(12,15,28,.85); color: var(--mute); }
  .step svg { position: absolute; left: 0; top: 0; width: 104px; height: 104px; overflow: visible; }
  #s1 { left: 116px; } #s2 { left: 362px; } #s3 { left: 608px; } #s4 { left: 854px; }
  #rail { position: absolute; left: 0; top: 0; width: 1080px; height: 400px; pointer-events: none; }
  .flow { fill: none; stroke: #3A4160; stroke-width: 3; stroke-dasharray: 8 10; }
  .arw { fill: none; stroke-width: 3; stroke-dasharray: 10 9; opacity: 0; }
  #key { position: absolute; left: 0; top: 0; width: 64px; height: 30px; filter: drop-shadow(0 0 10px rgba(245,185,74,.8)); }
  .kcopy { position: absolute; left: 0; top: 0; width: 64px; height: 30px; opacity: 0; filter: drop-shadow(0 0 10px rgba(245,185,74,.8)); z-index: 5; }
  #shieldmini { position: absolute; left: 272px; top: 180px; width: 38px; height: 68px; opacity: 0; }

  /* headline (Rethink: heavy + light pairing) */
  .ttl { position: absolute; left: 70px; width: 940px; top: 360px; font-size: 76px; line-height: 1.06; letter-spacing: -0.03em; }
  .ttl .tw { display: inline-block; opacity: 0; font-weight: 800; }
  .ttl .lt { font-weight: 300; }
  .ttl .acc { color: var(--accent); } .ttl .bad { color: var(--bad); } .ttl .good { color: var(--good); }

  /* neon hairline panels (Algo Reels) */
  .panel { position: absolute; border-radius: 18px; background: rgba(12,15,28,.78); border: 1.5px solid var(--c, rgba(124,140,255,.45));
    box-shadow: 0 0 28px -6px var(--c, rgba(124,140,255,.45)), inset 0 1px 0 rgba(255,255,255,.04); opacity: 0; }
  .panel .hd { position: absolute; left: 22px; top: 14px; font: 500 28px var(--mono); letter-spacing: .1em; color: var(--hc, #AEB8FF); }
  .term { font: 400 30px var(--mono); color: var(--ink); }
  .term .ln { position: absolute; left: 28px; white-space: pre; }
  .term .ps { color: var(--accent); }
  .ok { color: var(--good); } .warn { color: var(--warn); } .badc { color: var(--bad); }

  /* numerals (Rethink gradient) */
  .num { position: absolute; left: 70px; width: 940px; text-align: center; font: 800 200px var(--display); letter-spacing: -0.05em; line-height: 1;
    background: linear-gradient(180deg, #EEF1FF 20%, #7C8CFF 100%); -webkit-background-clip: text; background-clip: text; color: transparent; opacity: 0; font-variant-numeric: tabular-nums; }
  .lbl { position: absolute; left: 70px; width: 940px; text-align: center; font: 500 28px var(--mono); letter-spacing: .08em; line-height: 1.5; color: var(--mute); opacity: 0; }
  .chip { position: absolute; font: 700 28px var(--mono); padding: 10px 18px; border-radius: 10px; border: 1.5px solid var(--c); color: var(--c); background: rgba(12,15,28,.85);
    box-shadow: 0 0 18px -6px var(--c); white-space: nowrap; opacity: 0; }

  /* "THIS IS CALLED" callout */
  .called { position: absolute; left: 0; width: 1080px; text-align: center; opacity: 0; }
  .called small { display: block; font: 500 28px var(--mono); letter-spacing: .22em; color: var(--mute); margin-bottom: 10px; }
  .called span { display: inline-block; font: 800 46px var(--display); padding: 12px 26px; border-radius: 14px; border: 1.5px solid var(--good); color: var(--good); background: rgba(12,15,28,.85); box-shadow: 0 0 30px -8px var(--good); }

  /* dot matrix (Rethink "this is you.") + scan beam */
  #matrixwrap { position: absolute; left: 149px; top: 590px; width: 782px; height: 506px; opacity: 0; }
  #matrix circle { fill: rgba(238,241,255,.82); }
  #beam { position: absolute; top: -20px; left: 0; width: 120px; height: 546px; background: linear-gradient(90deg, transparent, rgba(124,140,255,.35), transparent); opacity: 0; }
  #hottag { position: absolute; left: 524px; top: 827px; font: 500 28px var(--mono); padding: 6px 12px; border-radius: 8px; border: 1px solid rgba(255,90,110,.6); color: #FFD5DB; background: rgba(20,8,14,.9); opacity: 0; }

  /* tilted plane of masked key chips (Rethink role wall) */
  #planewrap { position: absolute; left: -200px; top: 560px; width: 1480px; height: 560px; overflow: hidden; opacity: 0;
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, #000 35%, transparent 75%); }
  #plane { position: absolute; left: 0; top: -160px; width: 1900px; display: flex; flex-wrap: wrap; gap: 14px 18px;
    transform-origin: 50% 50%; }
  .kchip { font: 500 22px var(--mono); color: rgba(198,206,255,.55); padding: 8px 14px; border-radius: 8px; border: 1px solid rgba(124,140,255,.25); background: rgba(20,26,56,.55); }
  .kchip i { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); margin-right: 8px; }
  #scrim { position: absolute; left: 40px; top: 580px; width: 1000px; height: 560px; border-radius: 50%; background: radial-gradient(ellipse, rgba(7,9,15,.92) 30%, transparent 70%); opacity: 0; }

  /* timeline chart (Rethink curve) */
  #chart { position: absolute; left: 70px; top: 640px; width: 940px; height: 420px; opacity: 0; }

  /* evidence cards: real source pages (tools/capture) — reference: Instagram reel DfH6Z5NzECg */
  #evl { position: absolute; inset: 0; pointer-events: none; }
  .evcard { position: absolute; left: 70px; top: 610px; width: 940px; height: 720px; border-radius: 22px; overflow: hidden; opacity: 0;
    background: #0D1117; border: 1.5px solid rgba(124,140,255,.45); box-shadow: 0 30px 80px -20px rgba(0,0,0,.8), 0 0 34px -8px rgba(124,140,255,.45); }
  .evbar { position: absolute; left: 0; top: 0; width: 940px; height: 60px; background: #161B26; border-bottom: 1px solid #262D40; font: 500 28px var(--mono); color: #AEB8FF; }
  .evbar i { position: absolute; top: 24px; width: 12px; height: 12px; border-radius: 50%; background: #3A4160; }
  .evbar span { position: absolute; left: 92px; top: 12px; }
  .evbar b { position: absolute; right: 22px; top: 12px; font-weight: 500; color: var(--warn); }
  .evwin { position: absolute; left: 0; top: 60px; width: 940px; height: 660px; overflow: hidden; }
  .evin { position: absolute; left: 0; top: 0; transform-origin: 0 0; }
  .evin img { display: block; }
  .hl { position: absolute; background: #FFFFFF; mix-blend-mode: difference; transform-origin: 0 50%; transform: scaleX(0); }   /* inverted marker, as in the reference */
  #flashov { position: absolute; inset: 0; background: #E9ECFF; opacity: 0; pointer-events: none; }
  #bar, #rail, .step, #key { opacity: 0; }   /* HUD builds in after the opening flash: nothing static at frame 0 */

  /* slot-roll numeral: each digit is a strip that rolls to its value */
  .slot { white-space: nowrap; background: none !important; color: var(--ink); }
  .slot .col { display: inline-block; height: 1em; overflow: hidden; vertical-align: top; }
  .slot .col > div { display: block; }
  .slot .d { display: block; height: 1em; background: linear-gradient(180deg, #EEF1FF 20%, #7C8CFF 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }

  /* captions: middle, karaoke grey to white (both references) */
  .capg { position: absolute; left: 70px; width: 940px; top: 1400px; text-align: center; font: 700 62px var(--display); letter-spacing: -0.015em; line-height: 1.15; opacity: 0; color: #6A7396; }
</style>
</head>
